# Dead Rising 2: Case Zero — what the Android scripts need to know about this game.
# Sourced by scripts/common.sh (bash). Keep it plain KEY=VALUE.

GAME_ID=casezero
GAME_TITLE="Dead Rising 2: Case Zero"
# The folder name the upstream runtime uses for saves (host_paths.cpp kGameFolder).
GAME_FOLDER="Dead Rising 2 Case Zero"

UPSTREAM_REPO=https://github.com/wivi514/Dead_Rising_2_Case_Zero_Xenon_Recomp
# v1.1.3 + docs: the final upstream release ("finished, no further updates").
UPSTREAM_COMMIT=10d45b0952dd1b7f53f29dbff0795a27abb81ff7

# The prefix upstream uses for its CMake options and environment variables.
PFX=CZ
RUNTIME=cz_runtime
RECOMP_TOML=CaseZero.toml

# Xbox 360 title id: the folder the XBLA package sits under on the console.
TITLE_ID=58410A8D
PS_BANK=deadrisingprologue-ps.big
