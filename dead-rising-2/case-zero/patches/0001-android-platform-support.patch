+            R->swap.surface = VK_NULL_HANDLE;
+            fprintf(stderr, "[vk] android: window surface gone (app in background) — "
+                            "swapchain released, presents paused\n");
+        }
+        Dr2Android_SurfaceReleased();
+        while (Dr2Android_SurfaceLost())
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    }
