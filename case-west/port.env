# Dead Rising 2: Case West — what the Android scripts need to know about this game.
# Sourced by scripts/common.sh (bash). Keep it plain KEY=VALUE.

GAME_ID=casewest
GAME_TITLE="Dead Rising 2: Case West"
# The folder name the upstream runtime uses for saves (host_paths.cpp kGameFolder).
GAME_FOLDER="Dead Rising 2 Case West"

UPSTREAM_REPO=https://github.com/wivi514/Dead_Rising_2_Case_West_Xenon_Recomp
# v1.1.2 + docs: the final upstream release.
UPSTREAM_COMMIT=ba78bde572d654022f35e00eb9860be6c4583456

# The prefix upstream uses for its CMake options and environment variables.
PFX=CW
RUNTIME=cw_runtime
RECOMP_TOML=CaseWest.toml

# Xbox 360 title id: the folder the XBLA package sits under on the console.
TITLE_ID=58410B00
PS_BANK=deadrisingepilogue-ps.big
